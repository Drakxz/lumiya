# Preencha no .env existente. Nunca substitua suas credenciais por este exemplo.
DISCORD_TOKEN=
# Reutiliza a aplicação do bot: Developer Portal > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Só ative com aprovação do Discord para o escopo de parceiro identify.premium.
# Sem aprovação, mantenha false para não impedir o login.
DISCORD_IDENTIFY_PREMIUM_ENABLED=false
DISCORD_REDIRECT_URI=https://fotos.exemplo.com/api/auth/discord/callback
DISCORD_GUILD_ID=
# Destino existente de !instagram tem prioridade quando não houver configuração web.
DISCORD_INSTAGRAM_CHANNEL_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_SERVER_INVITE=https://discord.gg/SEUCONVITE
# Opcional e apenas visual: token de CONTA SECUNDÁRIA (nunca de bot) já usado
# na verificação de bio. Permite ler as insígnias que essa conta vê no perfil.
# É uma API não oficial: pode falhar ou causar punição na conta. Deixe vazio
# para desativar. O token nunca é enviado ao navegador nem gravado no banco.
DISCORD_BIO_CHECK_USER_TOKEN=
# false desliga só a consulta visual de insígnias do site; a verificação de bio
# existente continua respeitando o token acima.
WEB_PROFILE_BADGES_USER_LOOKUP_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Desativado por padrão. Ative só depois de preencher e compilar o frontend.
INSTAGRAM_WEB_ENABLED=false
SESSION_SECRET=
APP_URL=https://fotos.exemplo.com
NODE_ENV=production
PORT=3000
WEB_HOST=127.0.0.1
# Somente IP/CIDR dos proxies que você controla. Nunca "true" ou 0.0.0.0/0.
WEB_TRUST_PROXY=127.0.0.1/32,::1/128
STORAGE_PATH=./database/instagram-web-private
WEB_MAX_STORAGE_MB=512
TZ=America/Sao_Paulo

# Banco SQLite COMPARTILHADO do bot; não use PostgreSQL/Redis sem migração.
CALL_STATS_FILE=./database/call-stats.sqlite
# DATABASE_URL e REDIS_URL não são utilizados nesta arquitetura.
# INTERNAL_API_SECRET não é necessário: não existe API interna entre processos.
# MAX_UPLOAD_SIZE e MAX_IMAGES_PER_POST são gerenciados no painel:
# valores iniciais de 10 MB/imagem e 5 fotos, com limites rígidos seguros.

# Credencial opcional exclusiva para o sistema de nomes já existente
NICKNAME_AI_API_KEY=
