# Modelo de configuração da Lumiya.
# Nunca substitua o .env existente por este arquivo. Preencha apenas o necessário.
# Valores em branco significam "usar o padrão do código" ou "desativado".

# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_INSTAGRAM_CHANNEL_ID=
DISCORD_SERVER_INVITE=https://discord.gg/SEUCONVITE
DISCORD_IDENTIFY_PREMIUM_ENABLED=false
# Conta secundária (nunca o bot) usada apenas para insígnias visuais e calls extras.
DISCORD_BIO_CHECK_USER_TOKEN=
DISCORD_EXTRA_CALL_TOKEN=
DISCORD_EXTRA_CALL_CHANNEL_ID=
WEB_PROFILE_BADGES_USER_LOOKUP_ENABLED=true

# ---------------------------------------------------------------------------
# Cargos, canais e arquivos de estado (específicos da instalação)
# ---------------------------------------------------------------------------
STAFF_ROLE_ID=
CATEGORY_ID=
GESTAO_SUPORTE_ROLE_ID=
GESTAO_MIGRACAO_ROLE_ID=
GESTAO_TICKETS_ADMIN_ROLE_ID=
ROLE_ADDITION_LOG_CHANNEL_ID=
HISTORY_PERMISSION=
TOP_LIVE_INTERVAL_MS=15000
COMMAND_CENTER_SHOW_RESTRICTED=false
CALL_STATS_FILE=./database/call-stats.sqlite
DATA_FILE=./data.json
ROLE_HISTORY_FILE=./role-history.json

# ---------------------------------------------------------------------------
# Provedores de inteligência artificial
# ---------------------------------------------------------------------------
# auto | openai | gemini | bedrock
AI_CHAT_PROVIDER=auto
AI_CHAT_ENABLED=true
AI_CHAT_BEDROCK_MODEL=openai.gpt-oss-safeguard-20b
AI_CHAT_BEDROCK_FALLBACK_MODEL=openai.gpt-oss-20b
AI_CHAT_COOLDOWN_MS=4000
AI_CHAT_CONTEXT_MESSAGES=50
AI_CHAT_CONTEXT_MAX_MESSAGES=200
AI_CHAT_CONTEXT_CHARS=7000
AI_CHAT_MEMORY_RETENTION_DAYS=14
AI_CHAT_SUMMARY_ENABLED=true
AI_CHAT_MAX_CONCURRENT=3
# Participação espontânea é desligada por padrão.
AI_CHAT_SPONTANEOUS_CHANCE=0.08
AI_CHAT_TRIGGER_WORDS=

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Sulafat
MEDIA_MODERATION_GEMINI_MODEL=
MEDIA_MODERATION_TRANSCRIPTION_MODEL=

GROQ_API_KEY=

# Bedrock: use AWS_BEARER_TOKEN_BEDROCK (endpoint Mantle) ou credenciais IAM
# padrão do SDK (AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY) para Nova Sonic.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-2
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Voz / chat de IA
# ---------------------------------------------------------------------------
AI_CHAT_AUDIO_ENABLED=true
AI_CHAT_AUDIO_MODE=always
# bedrock | openai | gemini
AI_CHAT_TTS_PROVIDER=bedrock
AI_CHAT_AUDIO_MAX_PER_MINUTE=6
AI_CHAT_BEDROCK_TTS_REGION=us-east-1
AI_CHAT_BEDROCK_TTS_MODEL=amazon.nova-2-5-sonic
AI_CHAT_BEDROCK_TTS_VOICE=carolina
# Substitui o prompt de voz institucional apenas se você souber o que faz.
AI_CHAT_BEDROCK_TTS_PROMPT=

# ---------------------------------------------------------------------------
# Proteção de nomes
# ---------------------------------------------------------------------------
NICKNAME_AI_ENABLED=
NICKNAME_AI_PROVIDER=
NICKNAME_AI_MODEL=
NICKNAME_AI_API_KEY=
NICKNAME_AI_DAILY_REQUESTS=

# ---------------------------------------------------------------------------
# Moderação de mídias
# ---------------------------------------------------------------------------
MEDIA_MODERATION_ENABLED=
MEDIA_MODERATION_MAX_FILE_MB=
MEDIA_MODERATION_MAX_VIDEO_SECONDS=
MEDIA_MODERATION_MAX_FRAMES=
MEDIA_MODERATION_FRAME_INTERVAL_SECONDS=
MEDIA_MODERATION_MAX_FRAME_GAP_SECONDS=
MEDIA_MODERATION_SCENE_FRAMES=
MEDIA_MODERATION_AUDIO_ENABLED=
MEDIA_MODERATION_REQUIRE_AUDIO=
MEDIA_MODERATION_DAILY_BUDGET_USD=
MEDIA_MODERATION_DAILY_REQUESTS=
MEDIA_MODERATION_CHANNEL_PER_MINUTE=
MEDIA_MODERATION_MAX_QUEUE=
MEDIA_MODERATION_MAX_CONCURRENT=
MEDIA_MODERATION_API_TIMEOUT_MS=20000
MEDIA_MODERATION_API_RETRIES=2
MEDIA_MODERATION_RETENTION_HOURS=

# ---------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------
BACKUP_DIRECTORY=./backups/files
BACKUP_ADMIN_IDS=
BACKUP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Painel de calls (servidor local, não expor publicamente)
# ---------------------------------------------------------------------------
CALL_PANEL_ENABLED=false
CALL_PANEL_PORT=3210
CALL_PANEL_STORE_FILE=
CALL_PANEL_KEY_FILE=

# ---------------------------------------------------------------------------
# Portal de fotografias (opt-in)
# ---------------------------------------------------------------------------
INSTAGRAM_WEB_ENABLED=false
DISCORD_REDIRECT_URI=https://fotos.exemplo.com/api/auth/discord/callback
SESSION_SECRET=
APP_URL=https://fotos.exemplo.com
NODE_ENV=production
PORT=3000
WEB_HOST=127.0.0.1
# Somente IP/CIDR dos proxies que você controla. Nunca "true" ou 0.0.0.0/0.
WEB_TRUST_PROXY=127.0.0.1/32,::1/128
STORAGE_PATH=./database/instagram-web-private
WEB_MAX_STORAGE_MB=512
TZ=America/Sao_Paulo

# ---------------------------------------------------------------------------
# Não configurar — não são utilizados por esta arquitetura
# ---------------------------------------------------------------------------
# DATABASE_URL=
# REDIS_URL=
# INTERNAL_API_SECRET=
# MAX_UPLOAD_SIZE=
# MAX_IMAGES_PER_POST=

# ---------------------------------------------------------------------------
# Apenas testes locais (não usar em produção)
# ---------------------------------------------------------------------------
# MOBILE_LIVE_URL=
# SITE_URL=
# HOURS_TEST_PREVIEW=
