{
  "name": "mds-bot",
  "version": "1.0.0",
  "description": "Bot do servidor mds - painel de suporte e painel de migracao (Discord Components V2).",
  "main": "start.js",
  "type": "commonjs",
  "scripts": {
    "start": "node start.js",
    "test": "node --test",
    "web:install": "npm --prefix instagram-web/frontend ci",
    "web:build": "npm --prefix instagram-web/frontend run build",
    "web:dev": "npm --prefix instagram-web/frontend run dev",
    "web:check": "npm --prefix instagram-web/frontend run check",
    "web:e2e": "npm --prefix instagram-web/frontend exec -- playwright test --config instagram-web/frontend/playwright.config.ts",
    "web:backup": "node instagram-web/backup.cjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1178.0",
    "@discordjs/voice": "^0.19.2",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@napi-rs/canvas": "^1.1.0",
    "@smithy/node-http-handler": "^4.14.2",
    "@snazzah/davey": "^0.2.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "file-type": "^22.3.0",
    "openai": "^7.56.0",
    "sharp": "^0.35.5",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  }
}
